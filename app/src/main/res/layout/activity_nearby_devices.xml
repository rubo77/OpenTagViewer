<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="handleClickBack" type="Runnable" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/settings_top_toolbar"
            layout="@layout/inline_top_toolbar"
            app:onClickBack="@{handleClickBack}"
            app:pageTitle="@{@string/nearby_devices_title}" />

        <!-- The opt-in for presence alerts: keeps watching named devices in the background
             and notifies when they arrive or leave. Off by default - it is a recording the
             user chooses, not a display. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nearby_presence_toggle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/nearby_presence_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- The row of filters over the list plus the export: single-selection chips keep it
             one rule at a time, and the share icon writes names + sighting log as JSON. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/nearby_filter_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/nearby_filter_all"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/nearby_filter_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/nearby_filter_online"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nearby_filter_online" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/nearby_filter_own"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nearby_filter_own" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/nearby_filter_named"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nearby_filter_named" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/nearby_filter_unnamed"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nearby_filter_unnamed" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/nearby_export_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nearby_export"
                android:src="@drawable/share_24px"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Offered while a named tag seems to have rotated its key: confirm moves the name
             onto the new prefix, dismiss silences the question for this session. Hidden
             unless the rotation heuristic has a candidate. -->
        <LinearLayout
            android:id="@+id/nearby_rotation_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/nearby_rotation_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="This might be “Keys” broadcasting a new key" />

            <Button
                android:id="@+id/nearby_rotation_confirm"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_rotation_confirm" />

            <Button
                android:id="@+id/nearby_rotation_dismiss"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_rotation_dismiss" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/nearby_devices_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Shown instead of the list while nothing has been heard - which is also the state
             Bluetooth-off and permission-missing land in, distinguished by the text. -->
        <LinearLayout
            android:id="@+id/nearby_devices_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/nearby_devices_empty_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.4"
                android:contentDescription="@null"
                android:src="@drawable/devices_24px"
                app:tint="?attr/colorOutline" />

            <TextView
                android:id="@+id/nearby_devices_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/nearby_devices_empty"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>
</layout>
