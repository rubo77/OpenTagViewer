<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the screens whose functions die without an account or without Bluetooth:
     a thin red strip saying which leg is missing, with a way to fix each. Dark red while
     one side still works, full signal red when nothing does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/offline_banner_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="2dp"
    android:visibility="gone"
    tools:visibility="visible">

    <TextView
        android:id="@+id/offline_mode_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/offline_mode_banner"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <Button
        android:id="@+id/offline_mode_enable_bt"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:paddingVertical="0dp"
        android:text="@string/offline_mode_enable_bt"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <Button
        android:id="@+id/offline_mode_sign_in"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:paddingVertical="0dp"
        android:text="@string/offline_mode_sign_in"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
